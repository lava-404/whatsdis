# URL of the Python detection service.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Milliseconds between frame submissions. 250 is roughly 4 fps and is
# comfortable on a laptop CPU; raise it on slower hardware.
NEXT_PUBLIC_DETECT_INTERVAL_MS=250

# Longest edge of the JPEG sent to the backend. Bigger is more accurate and
# slower; YOLO letterboxes to 640 anyway.
NEXT_PUBLIC_CAPTURE_MAX_EDGE=640
